---
import "../styles/index.scss"

import Layout from "../layouts/Layout.astro"
import { getGroup } from "../lib/groups"
import { getGroupYears } from "../lib/years"

const groupYears = getGroupYears()
---

<Layout title="Blog Contributions">
  <div class="index">
    <ul class="index__groups">
      {
        groupYears.map(({ key, years }) => (
          <li class="index__groups__group">
            <h2>{getGroup(key)?.englishShort}</h2>
            <ul class="index__groups__group__years">
              {years.map(year => (
                <li class="index__groups__group__years__year">
                  <a href={`/${key}/${year}`} title={`${getGroup(key)?.englishShort} ${year}`}>
                    {year}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</Layout>
