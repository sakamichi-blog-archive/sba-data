{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sakamichi-blog-archive-web",
  "compatibility_date": "2026-08-06",
  "assets": {
    "directory": "./dist"
  },
  "dev": {
    "port": 6728
  },
  "routes": [
    {
      "pattern": "contributions.sakamichi.co",
      "custom_domain": true
    }
  ]
}
