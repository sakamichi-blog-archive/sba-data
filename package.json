{
  "name": "sba-data",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "pnpm run format && pnpm run lint && pnpm run typecheck && pnpm run test",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "pnpm --filter @sakamichi-blog-archive/updater --filter @sakamichi-blog-archive/web run test",
    "typecheck": "pnpm --filter @sakamichi-blog-archive/updater --filter @sakamichi-blog-archive/web run typecheck"
  },
  "devDependencies": {
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0"
  },
  "packageManager": "pnpm@11.28.12+sha512.94833387e35d503e8ad1010417cdeb82c120e7e69bafdf0a9db0690515beae7159274571e692b96abc2a085d3566fec54381afd978f65f64a85362dfd7e108f7"
}
