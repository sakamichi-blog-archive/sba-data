{
  "name": "sba-data",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "pnpm run format && pnpm run lint && pnpm run typecheck && pnpm run test",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "pnpm --filter @sakamichi-blog-archive/updater --filter @sakamichi-blog-archive/web run test",
    "typecheck": "pnpm --filter @sakamichi-blog-archive/updater --filter @sakamichi-blog-archive/web run typecheck"
  },
  "devDependencies": {
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0"
  },
  "packageManager": "pnpm@11.10.0+sha512.0b7f8b98060031904c017e3a41eb187a16d40eeb829b95c4f8cb03681761fc4ab53dd219115b9b447f4dce1a05a214764461e7d3703392a9f32f9511ce8c86c8"
}
